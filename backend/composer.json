{
  "name": "kost-shukoh/backend",
  "type": "project",
  "description": "Kost Shukoh Management System - Laravel REST API Backend",
  "keywords": ["laravel", "framework", "kost-management-system", "rest-api"],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "laravel/sanctum": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  }
}
